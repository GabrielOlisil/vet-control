# Copy to .env.production locally. Never commit real credentials or private keys.
APP_DOMAIN=clinic.example.test
AUTH_DOMAIN=identity.example.test
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_WITHOUT_SEMICOLONS
OIDC_CLIENT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
SIGNING_CERTIFICATE_PASSWORD=REPLACE_WITH_CERTIFICATE_PASSWORD
ENCRYPTION_CERTIFICATE_PASSWORD=REPLACE_WITH_CERTIFICATE_PASSWORD
DATA_PROTECTION_CERTIFICATE_PASSWORD=REPLACE_WITH_CERTIFICATE_PASSWORD
# Absolute paths on the deployment host; directories must exist before deployment.
TLS_CERTIFICATES_PATH=./deployment/certificates/tls
CRYPTO_CERTIFICATES_PATH=./deployment/certificates/crypto
CLINIC_TIME_ZONE=America/Manaus
PROXY_IP=172.30.240.10
PROXY_SUBNET=172.30.240.0/24
